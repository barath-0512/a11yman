# Override the canonical site URL used in metadata / sitemap / robots.
# Set this to your production domain so canonicals & the sitemap are correct.
NEXT_PUBLIC_SITE_URL=https://a11yman.com

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (public). Leave unset to disable analytics.
# Get it: analytics.google.com → Admin → Data streams → your web stream → "G-XXXX".
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Search-engine ownership verification (site-verification <meta> tags) ─────
# Google Search Console: search.google.com/search-console → add the property →
# "HTML tag" method → copy only the `content="..."` token (not the whole tag).
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools: bing.com/webmasters → add site → "HTML Meta Tag" →
# copy the `content="..."` value of the <meta name="msvalidate.01"> tag.
# (Tip: Bing can also "Import from Google Search Console" instead.)
BING_SITE_VERIFICATION=
